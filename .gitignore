# =========================
# Node / npm
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# =========================
# Build outputs
# =========================
dist/
dist-*/
build/
out/
release/
releases/
*.tsbuildinfo

# Electron build artifacts
dist-electron/
electron-build/
app-build/
*.map

# =========================
# Vite / tooling cache
# =========================
.vite/
.cache/
.tmp/
temp/
.eslintcache
.stylelintcache

# =========================
# Env files
# =========================
.env
.env.*
!.env.example

# =========================
# OS / Editor
# =========================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

.idea/
.vscode/
*.swp
*.swo

# =========================
# FFmpeg / app runtime artifacts
# =========================
# Preview renders / waveform images / temp audio produced by the app
waveforms/
previews/
renders/
*.wav
*.mp3
*.m4a

# If you write temp files to a known folder
tmp/
tmp-ffmpeg/

# =========================
# TypeScript local type shims (keep if you want tracked)
# =========================
# If you created custom .d.ts shims and DO want to track them,
# remove the next line.
# types/**/*.d.ts

# =========================
# Optional: lockfiles (choose what you use)
# =========================
# If you use npm, keep package-lock.json tracked (recommended)
# If you want to ignore it, uncomment:
# package-lock.json

# yarn.lock
# pnpm-lock.yaml
